    given-names: "Enes"
    affiliation: "Department of Electrical and Electronics Engineering, Abdullah Gül University, Kayseri, Türkiye"
version: "0.1.0"
license: MIT
repository-code: "https://github.com/EnesErdogans/radarlab"
url: "https://eneserdogans.github.io/radarlab/"
keywords:
  - FMCW radar
  - MIMO radar
  - radar simulation
  - CFAR
  - micro-Doppler
  - Cramér–Rao bound
  - TI mmWave
